# Copy this file to .env and fill in real values. Never commit the real .env.

# RPC endpoint for Arbitrum Sepolia (testnet). Public default works, but a
# dedicated RPC (Alchemy/Infura/QuickNode) is more reliable for deploys.
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Deployer / relay wallet private key (testnet only — never put a mainnet
# key in a plaintext .env). Used by scripts/deploy.ts, scripts/demo.ts, and
# as the "relay" side in scripts/demo-relay.ts / demo-bond-lock.ts.
PRIVATE_KEY=

# A SECOND, separate testnet private key, playing the "agent" role in
# scripts/demo-relay.ts and scripts/demo-bond-lock.ts specifically — those
# scripts prove the relay pattern by using two genuinely distinct wallets
# (agent commits/signs, relay submits/pays gas). Must differ from
# PRIVATE_KEY above; both scripts throw if they're the same address.
AGENT_PRIVATE_KEY=

# Optional: Arbiscan API key, for contract verification.
ARBISCAN_API_KEY=
