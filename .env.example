# Copy this file to .env and fill in real values. Never commit the real .env.

# RPC endpoint for Arbitrum Sepolia (testnet). Public default works, but a
# dedicated RPC (Alchemy/Infura/QuickNode) is more reliable for deploys.
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Deployer / relay wallet private key (testnet only — never put a mainnet
# key in a plaintext .env). Used by scripts/deploy.ts, scripts/demo.ts, and
# as the "relay" side in scripts/demo-relay.ts / demo-bond-lock.ts.
PRIVATE_KEY=

# A SECOND, separate testnet private key, playing the "agent" role in
# scripts/demo-relay.ts and scripts/demo-bond-lock.ts specifically — those
# scripts prove the relay pattern by using two genuinely distinct wallets
# (agent commits/signs, relay submits/pays gas). Must differ from
# PRIVATE_KEY above; both scripts throw if they're the same address.
AGENT_PRIVATE_KEY=

# Optional: Arbiscan API key, for contract verification.
ARBISCAN_API_KEY=

# Only needed to run scripts/deploy-treasury.ts (deploys
# AncillaTreasuryMultisig — see README "Mainnet readiness"). Comma-separated
# list of DISTINCT, non-zero owner addresses, and how many of them must
# confirm a withdrawal before it executes. No default on purpose — a
# silently-chosen owner set for a treasury is worse than no multisig at all.
TREASURY_MULTISIG_OWNERS=
TREASURY_MULTISIG_THRESHOLD=

# Only needed to run scripts/deploy-guardian.ts (deploys
# AncillaGuardianMultisig — see README "Mainnet readiness"). Same shape as
# the treasury vars above; can reuse the same owner set or use a different
# one. No default on purpose, same reasoning.
GUARDIAN_MULTISIG_OWNERS=
GUARDIAN_MULTISIG_THRESHOLD=
