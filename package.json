    "deploy-guardian:sepolia": "hardhat run scripts/deploy-guardian.ts --network arbitrumSepolia",
    "demo-guardian-multisig:sepolia": "hardhat run scripts/demo-guardian-multisig.ts --network arbitrumSepolia",
    "demo-guardian-multisig-hook:sepolia": "hardhat run scripts/demo-guardian-multisig-hook.ts --network arbitrumSepolia",
    "deploy-token:sepolia": "hardhat run scripts/deploy-token.ts --network arbitrumSepolia",
    "demo-governor:sepolia": "hardhat run scripts/demo-governor.ts --network arbitrumSepolia",
    "demo-staking:sepolia": "hardhat run scripts/demo-staking.ts --network arbitrumSepolia",
    "deploy-vote-escrow:sepolia": "hardhat run scripts/deploy-vote-escrow.ts --network arbitrumSepolia",
    "demo-vote-escrow:sepolia": "hardhat run scripts/demo-vote-escrow.ts --network arbitrumSepolia",
