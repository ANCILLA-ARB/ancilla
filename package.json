{
  "name": "ancilla",
  "version": "1.0.0",
  "private": true,
  "description": "Commit-reveal + timing-batching privacy primitive for AI agent intents on Arbitrum. Not a ZK system — see README for exactly what this is and isn't.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas-report": "cross-env REPORT_GAS=true hardhat test",
    "size": "hardhat size-contracts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "deploy-swap:sepolia": "hardhat run scripts/deploy-swap.ts --network arbitrumSepolia",
    "deploy-treasury:sepolia": "hardhat run scripts/deploy-treasury.ts --network arbitrumSepolia",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "demo:sepolia": "hardhat run scripts/demo.ts --network arbitrumSepolia",
    "demo-relay:sepolia": "hardhat run scripts/demo-relay.ts --network arbitrumSepolia",
    "demo-bond-lock:sepolia": "hardhat run scripts/demo-bond-lock.ts --network arbitrumSepolia",
    "demo-swap:sepolia": "hardhat run scripts/demo-swap.ts --network arbitrumSepolia",
    "demo-treasury:sepolia": "hardhat run scripts/demo-treasury.ts --network arbitrumSepolia",
    "relay-server": "ts-node relay-server/index.ts",
    "relay-server:e2e": "ts-node scripts/relay-server-e2e.ts",
    "relay-server:multi-e2e": "ts-node scripts/relay-server-multi-e2e.ts"
  },
  "keywords": [
    "arbitrum",
    "solidity",
    "commit-reveal",
    "mev",
    "ai-agent",
    "eip-712",
    "amm",
    "defi"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANCILLA-ARB/ancilla.git"
  },
  "bugs": {
    "url": "https://github.com/ANCILLA-ARB/ancilla/issues"
  },
  "homepage": "https://github.com/ANCILLA-ARB/ancilla#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.1",
    "hardhat-contract-sizer": "^2.10.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "express": "^5.2.1"
  }
}
